<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A14"
    tools:context="dji.sampleV5.aircraft.DJIMainActivity">

    <!-- ═══════════════════════════════════════════════
         Scrollable content with staggered entrance animation
         ═══════════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutAnimation="@anim/layout_anim_cascade"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingBottom="40dp">

            <!-- ── Header / branding card ─────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_gradient"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:padding="20dp">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_drone"
                    tools:ignore="ContentDescription" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AeroSense"
                        android:textColor="#FFFFFF"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText" />

                    <TextView
                        android:id="@+id/text_view_aerosense_build_info"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:lineSpacingExtra="2dp"
                        android:textColor="#90A4AE"
                        android:textSize="11sp"
                        tools:text="Drone: mini1 · v1.0 · abc1234" />

                </LinearLayout>
            </LinearLayout>

            <!-- ── SDK status section label ───────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.08"
                android:text="SDK STATUS"
                android:textColor="#546E7A"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- ── SDK status card (clickable for pairing) ── -->
            <LinearLayout
                android:id="@+id/view_base_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?selectableItemBackground"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/text_view_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:textColor="#CFD8DC"
                    android:textSize="13sp"
                    tools:text="SDK Version: 5.x.x" />

                <TextView
                    android:id="@+id/text_view_registered"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/unregistered"
                    android:textColor="#CFD8DC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_view_product_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/product_name"
                    android:textColor="#CFD8DC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_view_package_product_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="5dp"
                    android:text="@string/package_product_category"
                    android:textColor="#CFD8DC"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/text_view_is_debug"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/is_sdk_debug"
                    android:textColor="#CFD8DC"
                    android:textSize="13sp" />

            </LinearLayout>

            <!-- ── Launch section label ───────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.08"
                android:text="LAUNCH"
                android:textColor="#546E7A"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- Default Layout — primary accent button -->
            <Button
                android:id="@+id/default_layout_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_bg_accent"
                android:elevation="2dp"
                android:enabled="false"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:text="@string/default_layout"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Widget List — secondary outlined button -->
            <Button
                android:id="@+id/widget_list_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/btn_bg_card_outline"
                android:elevation="2dp"
                android:enabled="false"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:text="@string/widget_list"
                android:textColor="#90CAF9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Testing Tools — secondary outlined button -->
            <Button
                android:id="@+id/testing_tool_button"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/btn_bg_card_outline"
                android:elevation="2dp"
                android:enabled="true"
                android:foreground="?selectableItemBackground"
                android:gravity="center"
                android:text="@string/testing_tools"
                android:textColor="#90CAF9"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- ── Resources section label ────────────────── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp"
                android:letterSpacing="0.08"
                android:text="RESOURCES"
                android:textColor="#546E7A"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:ignore="HardcodedText" />

            <!-- ── Resource links card ────────────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_dark"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="20dp">

                <!-- SDK Forum -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icon_sdk_forum"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:elevation="2dp"
                        android:foreground="?selectableItemBackground"
                        android:scaleType="centerInside"
                        android:src="@drawable/msg_icon"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/sdk_forum"
                        android:textColor="#78909C"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Release Notes -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icon_release_node"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:elevation="2dp"
                        android:foreground="?selectableItemBackground"
                        android:scaleType="centerInside"
                        android:src="@drawable/release_icon"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/release_nodes"
                        android:textColor="#78909C"
                        android:textSize="11sp" />

                </LinearLayout>

                <!-- Tech Support -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/icon_tech_support"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:elevation="2dp"
                        android:foreground="?selectableItemBackground"
                        android:scaleType="centerInside"
                        android:src="@drawable/tec_support_icon"
                        tools:ignore="ContentDescription" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="@string/tech_support"
                        android:textColor="#78909C"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Floating diagnostic overlay (bottom-right corner) -->
    <TextView
        android:id="@+id/text_core_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:textColor="#263238"
        android:textSize="9dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="SpUsage"
        tools:text="core" />

</androidx.constraintlayout.widget.ConstraintLayout>
